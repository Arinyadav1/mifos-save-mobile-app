# fastlane/Fastfile — CI-only lanes consumed by mifos-x-actionhub actions.
#
# The mifos-x-actionhub-build-ios-app action runs `bundle exec fastlane ios build_ios`
# from the repo root and expects fastlane/ to exist here.
# Deployment lanes (firebase / testflight / appstore) live in deployment/ and are
# invoked via `bundle exec fastlane --fastlane-dir deployment <platform> <lane>`.

default_platform(:ios)

platform :ios do
  desc "Build unsigned debug iOS app for PR checks (no signing, no archive)"
  lane :build_ios do
    # 1. Dynamically select the best available Xcode version to avoid build issues.
    # We look for stable releases like 16.x or 15.x first, then fall back to whatever is installed.
    xcode_paths = Dir.glob("/Applications/Xcode_16*.app") + Dir.glob("/Applications/Xcode_15*.app") + Dir.glob("/Applications/Xcode*.app")
    xcode_paths = xcode_paths.uniq.select { |p| File.directory?(p) }

    UI.message("Available Xcode versions: #{xcode_paths.map { |p| File.basename(p) }.join(', ')}")

    best_xcode = nil
    # Prefer Xcode 16.x
    best_xcode ||= xcode_paths.select { |p| p.include?("Xcode_16") }.sort.last
    # Fallback to Xcode 15.x
    best_xcode ||= xcode_paths.select { |p| p.include?("Xcode_15") }.sort.last
    # Fallback to any Xcode
    best_xcode ||= xcode_paths.sort.last

    if best_xcode
      UI.message("Selecting Xcode: #{best_xcode}")
      xcode_select(best_xcode)
    else
      UI.message("No specific Xcode version found in /Applications, using system default.")
    end

    # 2. Ensure the iOS SDK / platform is downloaded/installed for the selected Xcode version.
    # If already present, this command completes quickly.
    begin
      UI.message("Ensuring iOS platform is downloaded...")
      sh("xcodebuild -downloadPlatform iOS")
    rescue => e
      UI.error("Failed to run xcodebuild -downloadPlatform iOS: #{e.message}. Attempting to proceed anyway.")
    end

    cocoapods(
      podfile:                  "cmp-ios/Podfile",
      try_repo_update_on_error: true
    )

    build_ios_app(
      scheme:            "iosApp",
      workspace:         "cmp-ios/iosApp.xcworkspace",
      output_name:       "iosApp.ipa",
      output_directory:  "cmp-ios/build",
      skip_codesigning:  true,
      skip_archive:      true
    )
  end
end
